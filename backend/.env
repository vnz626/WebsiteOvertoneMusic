# Konfigurasi Environment Overtone Music Store
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=overtone_store

SECRET_KEY=overtone-secret-key-production-32-chars-long!
JWT_SECRET_KEY=overtone-jwt-secret-key-production-32-chars-long!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Upload dokumen
UPLOAD_DIR=

# Email otomatis (mock dev: ditulis ke log)
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@overtone.test

# Salin jadi .env lalu sesuaikan (opsional)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=overtone_store

SECRET_KEY=ubah-ini
JWT_SECRET_KEY=ubah-ini-juga
CORS_ORIGINS=http://localhost:5173

# Upload dokumen (default: backend/uploads)
UPLOAD_DIR=

# Email otomatis — biarkan MAIL_SUPPRESS_SEND=true untuk dev (email cuma ditulis ke log)
MAIL_SUPPRESS_SEND=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@overtone.test
